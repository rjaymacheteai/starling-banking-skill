// Starling banking skill: configuration
// Run `init` to copy this outside the skill folder. Settings: references/configuration.md
// Keep tokens and private keys in separate protected files or environment variables.
{
  "environment": "live",
  // Enable only what you need; groups are listed in references/permissions.md.
  "permissions": ["view"],
  "auth": {
    "tokenEnv": "STARLING_ACCESS_TOKEN",
    "tokenFile": null
  },
  // Required for signed operations; upload the public key to Starling first.
  "signing": {
    "keyUid": null,
    "keyFile": null,
    "algorithm": "auto"
  },
  "defaultAccountUid": null,
  // Payments remain blocked until both positive limits are set (major currency units).
  "limits": {
    "currency": "GBP",
    "perPayment": null,
    "perDay": null
  },
  "allowedPayees": [],
  "confirmation": {
    "mode": "agent",
    "expiresMinutes": 10
  }
}
